# Переменные окружения «Моя Эра». Скопировать в .env.local (локально) или
# внести в Vercel → Settings → Environment Variables. Без Supabase сайт
# работает в демо-режиме: аккаунты и люди живут в localStorage браузера.
#
# Полное описание: docs/PEREDACHA-PROGRAMMISTAM.md (п. 1), бот и задачи —
# docs/BOT.md (п. 2).

# ── Сайт ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=            # боевой домен, https://moyaera.ru
NEXT_PUBLIC_METRIKA_ID=          # номер счётчика Яндекс.Метрики
NEXT_PUBLIC_CONTACT_EMAIL=       # почта поддержки; пусто — контакта нет
NEXT_PUBLIC_TELEGRAM_URL=        # чат поддержки в Telegram; пусто — канала нет
NEXT_PUBLIC_MAX_URL=             # чат поддержки в Max; пусто — канала нет

# ── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=        # Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # там же → anon public
SUPABASE_SERVICE_ROLE_KEY=       # там же → service_role. Только сервер, без NEXT_PUBLIC_

# ── Нейросеть ───────────────────────────────────────────────────────
LLM_API_KEY=                     # ключ провайдера
LLM_BASE_URL=https://api.kie.ai/claude
LLM_MODEL_TEXTS=                 # модель для текстов разборов
LLM_MODEL_CHAT=                  # модель для наставника и раскладов

# ── Платежи (ЮKassa) ────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_AUTO_RENEW=              # 1 — включить автопродление; только после оферты с условиями автосписания

# ── Telegram-бот и задачи по расписанию ─────────────────────────────
TELEGRAM_BOT_TOKEN=              # от @BotFather; пусто — бот и панель в кабинете выключены
TELEGRAM_BOT_NAME=               # имя бота без @, для ссылок t.me/<имя>?start=
TELEGRAM_WEBHOOK_SECRET=         # секрет вебхука, любая случайная строка
CRON_SECRET=                     # Vercel Cron → Authorization: Bearer <секрет>
